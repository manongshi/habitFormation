APP_NAME=AI 考证教练 API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/ai_exam_coach?charset=utf8mb4
FRONTEND_ORIGINS=http://localhost:5173
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-max
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# 开发环境使用 mock；接入真实渠道后替换为对应 provider
PAYMENT_PROVIDER=mock
PAYMENT_CALLBACK_URL=https://api.example.com/api/v1/payments/callback
PAYMENT_RETURN_URL=https://example.com/pricing
REDIS_URL=redis://127.0.0.1:6379/0
EMAIL_CODE_SECRET=replace-with-a-long-random-string
EMAIL_CODE_EXPIRE_SECONDS=300
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_DAILY_LIMIT=20
# 本地可用 console；生产环境必须改成 smtp
EMAIL_DELIVERY_MODE=console
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=AI 考证教练
SMTP_FROM_EMAIL=
SMTP_USE_SSL=true
COS_REGION=ap-chengdu
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_PUBLIC_BASE_URL=
